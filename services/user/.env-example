# Example environment file for User Service
# Database connection string (Postgres)
POSTGRES_DSN=postgres://user:password@localhost:5432/user?sslmode=disable

# Redis connection string
REDIS_ADDR=localhost:6379

# Kafka broker addresses (comma separated)
KAFKA_BROKERS=localhost:9092

# Port for the user service
USER_SERVICE_PORT=8083

# Kafka topics (used in retry/DLQ logic)
RETRY_DLQ_TOPIC=user_created_dlq
DLQ_WORKER_SOURCE_TOPIC=user_created_dlq
DLQ_WORKER_FINAL_DLQ_TOPIC=user_created_dlq_final

# Retry and DLQ worker configuration (durations can use 1s, 1m, 1h, etc)
RETRY_MAX_DURATION=2h
RETRY_MAX_BACKOFF=30s
RETRY_INITIAL_BACKOFF=500ms
DLQ_WORKER_MAX_DURATION=1h
DLQ_WORKER_MAX_BACKOFF=5m
DLQ_WORKER_INITIAL_BACKOFF=5s
