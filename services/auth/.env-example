# Example environment variables for Auth Service

# Database
DATABASE_URL=postgres://auth:auth@localhost:5433/auth?sslmode=disable

# Kafka
KAFKA_BROKERS=localhost:29092

# Service Port
AUTH_PORT=8082

# Retry/DLQ
RETRY_MAX_DURATION=2h
RETRY_MAX_BACKOFF=30s
RETRY_INITIAL_BACKOFF=500ms
RETRY_DLQ_TOPIC=user_created_dlq
DLQ_WORKER_MAX_DURATION=1h
DLQ_WORKER_MAX_BACKOFF=5m
DLQ_WORKER_INITIAL_BACKOFF=5s
DLQ_WORKER_SOURCE_TOPIC=user_created_dlq
DLQ_WORKER_FINAL_DLQ_TOPIC=user_created_dlq_final

# Logging
LOG_LEVEL=info
