# ==========================
#  Auth Service .env Example
# ==========================

# Puerto HTTP donde escucha el Auth Service
AUTH_PORT=8082

# Nivel de logs (debug, info, warn, error)
LOG_LEVEL=info

# DSN de conexión a Postgres para Auth
AUTH_POSTGRES_DSN=postgres://auth:auth@localhost:5433/auth?sslmode=disable

# Brokers de Kafka (separados por coma)
KAFKA_BROKERS=localhost:9092

# Topic Kafka para usuarios
KAFKA_USER_TOPIC=user_created
# Topic Kafka para eventos de autenticación
KAFKA_AUTH_TOPIC=auth_events
# Grupo de consumidores Kafka para Auth
KAFKA_AUTH_CONSUMER_GROUP_NAME=auth-group
# Topic DLQ para eventos de autenticación
KAFKA_AUTH_DLQ_TOPIC=auth_events.dlq
# TTL de mensajes en DLQ (ej: 168h = 7 días)
KAFKA_AUTH_DLQ_TTL=168h
# Máxima duración de reintentos
KAFKA_AUTH_RETRY_MAX_DURATION=2h
# Máximo backoff entre reintentos
KAFKA_AUTH_RETRY_MAX_BACKOFF=300s
# Backoff inicial para reintentos
KAFKA_AUTH_RETRY_INITIAL_BACKOFF=5s
