# ===========================
#  Tweet Service .env Example
# ===========================

# --- Service ---
# Puerto donde corre el servicio Tweet
TWEET_PORT=8084
# Nivel de logs: debug, info, warn, error
LOG_LEVEL=debug

# --- Database ---
# DSN de conexión a Postgres
TWEET_POSTGRES_DSN=postgres://tweet:tweet@postgres-tweet:5432/tweet?sslmode=disable
# Dirección de Redis
TWEET_REDIS_ADDR=redis-tweet:6379

# --- Kafka ---
# Brokers de Kafka separados por coma
KAFKA_BROKERS=kafka:9092

# --- Kafka Tweet Consumer Config ---
# Nombre del grupo de consumidores de tweets
KAFKA_TWEET_CONSUMER_GROUP_NAME=tweet-service-group
# Nombre del topic de tweets
KAFKA_TWEET_TOPIC=tweets.events
# Nombre del topic DLQ para tweets
KAFKA_TWEET_DLQ_TOPIC=tweets.events.dlq
# Tiempo de vida de los mensajes en DLQ (ej: 168h = 7 días)
KAFKA_TWEET_DLQ_TTL=168h
# Máxima duración de reintentos
KAFKA_TWEET_RETRY_MAX_DURATION=2h
# Máximo backoff entre reintentos
KAFKA_TWEET_RETRY_MAX_BACKOFF=300s
# Backoff inicial para reintentos
KAFKA_TWEET_RETRY_INITIAL_BACKOFF=5s
