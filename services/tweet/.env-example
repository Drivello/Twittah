# ===========================
#  Tweet Service .env Example
# ===========================

# Puerto HTTP donde escucha el Tweet Service
TWEET_PORT=8084

# Nivel de logs (debug, info, warn, error)
LOG_LEVEL=debug

# DSN de conexión a Postgres para Tweet
TWEET_POSTGRES_DSN=postgres://tweet:tweet@localhost:5432/tweet?sslmode=disable
# Dirección de Redis
TWEET_REDIS_ADDR=localhost:6379

# TTL de timelines en Redis (en horas)
TIMELINE_TTL_HOURS=24

# URL del microservicio User (ej: http://user:8083)
USER_MICROSERVICE_URL=http://localhost:8083

# Brokers de Kafka (separados por coma)
KAFKA_BROKERS=localhost:9092

# Grupo de consumidores Kafka para tweets
KAFKA_TWEET_CONSUMER_GROUP_NAME=tweet-service-group
# Topic Kafka para tweets
KAFKA_TWEET_TOPIC=tweets.events
# Topic DLQ para tweets
KAFKA_TWEET_DLQ_TOPIC=tweets.events.dlq
# TTL de mensajes en DLQ (ej: 168h = 7 días)
KAFKA_TWEET_DLQ_TTL=168h
# Máxima duración de reintentos
KAFKA_TWEET_RETRY_MAX_DURATION=2h
# Máximo backoff entre reintentos
KAFKA_TWEET_RETRY_MAX_BACKOFF=300s
# Backoff inicial para reintentos
KAFKA_TWEET_RETRY_INITIAL_BACKOFF=5s
