# Example environment for TweetService
# PostgreSQL connection string (username:password@host:port/dbname?sslmode=disable)
POSTGRES_DSN=postgres://tweet:tweet@localhost:5432/tweet?sslmode=disable

# Redis server address (host:port)
REDIS_ADDR=localhost:6379

# Kafka broker addresses (comma-separated, e.g. localhost:9092,localhost:9093)
KAFKA_BROKERS=localhost:9092

# Kafka consumer group ID for this service instance
KAFKA_GROUP_ID=tweet-service-group

# HTTP port for the TweetService (default: 8080)
SERVICE_PORT=8080

# Timeline cache TTL in hours (default: 24)
TIMELINE_TTL_HOURS=24
