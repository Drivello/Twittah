  "item": [
    {
      "name": "Auth - Registrar Usuario",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"123456\"\n}" },
        "url": {
          "raw": "http://localhost:8081/auth/register",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8081",
          "path": ["auth", "register"]
        }
      },
      "response": []
    },
    {
      "name": "Auth - Validar Usuario",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"token\": \"<jwt-token>\"\n}" },
        "url": {
          "raw": "http://localhost:8081/auth/validate",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8081",
          "path": ["auth", "validate"]
        }
      },
      "response": []
    },
    {
      "name": "Auth - Desactivar Usuario",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"user_id\": \"123\"\n}" },
        "url": {
          "raw": "http://localhost:8081/auth/deactivate",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8081",
          "path": ["auth", "deactivate"]
