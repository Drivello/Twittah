# Example environment variables for Gateway Service
# Copy this file to .env-local and fill in real values for local development

# The port the Gateway HTTP server will listen on
GATEWAY_PORT=8081

# Comma-separated list of Kafka broker addresses
KAFKA_BROKERS=localhost:9092

# Kafka topic for follow events
KAFKA_FOLLOWS_TOPIC=follows

# Kafka topic for user events
KAFKA_USER_TOPIC=user_created
