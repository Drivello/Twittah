# ===========================
#  Gateway Service .env Example
# ===========================

# Puerto HTTP donde escucha el gateway
GATEWAY_PORT=8081

# Nivel de logs (debug, info, warn, error)
LOG_LEVEL=info

# Brokers de Kafka (separados por coma)
KAFKA_BROKERS=localhost:9092

# Topic Kafka para eventos de usuario
KAFKA_USER_TOPIC=user_created
# Topic Kafka para eventos de autenticación
KAFKA_AUTH_TOPIC=auth_events
# Topic Kafka para eventos de tweets
KAFKA_TWEET_TOPIC=tweet_events

# URL del microservicio User (ej: http://user:8083)
USER_MICROSERVICE_URL=http://localhost:8083
# URL del microservicio Tweet (ej: http://tweet:8084)
TWEET_MICROSERVICE_URL=http://localhost:8084
